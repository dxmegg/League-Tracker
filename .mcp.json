{
  "mcpServers": {
    "opgg": {
      "type": "http",
      "url": "https://mcp-api.op.gg/mcp",
      "tools": ["*"]
    },
    "sqlite": {
      "command": "npx",
      "args": ["-y", "--allow-scripts=sqlite3", "mcp-sqlite", "data/matches.db"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    }
  }
}